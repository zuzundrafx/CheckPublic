<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- Отключаем автоматическое включение Content -->
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <!-- Явно указываем выходную папку -->
    <PublishDir>dist</PublishDir>
  </PropertyGroup>

 <ItemGroup>
  <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.0" />
  <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.0" PrivateAssets="all" />
</ItemGroup>

  <!-- Явно включаем только нужные файлы -->
  <ItemGroup>
    <Content Include="wwwroot\index.html" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="wwwroot\js\telegram.js" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="wwwroot\css\app.css" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="wwwroot\service-worker.js" CopyToPublishDirectory="PreserveNewest" />

    <None Remove="Layout\MainLayout.razor.css" />
    <None Remove="Layout\NavMenu.razor.css" />

  </ItemGroup>

</Project>