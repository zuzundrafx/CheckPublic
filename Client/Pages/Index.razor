@page "/"
@inject HttpClient Http
@inject IJSRuntime JSRuntime
@using Client.Models  <!-- Добавьте эту строку -->

<h1>UFC Fantasy</h1>

@if (user == null)
{
    <p>Загрузка данных из Telegram...</p>
}
else
{
    <p>Привет, @user.Username!</p>
}

@code {
    private User? user;

    protected override async Task OnInitializedAsync()
    {
        try 
        {
            // Получаем данные из Telegram
            var telegramData = await JSRuntime.InvokeAsync<TelegramUserData>("getTelegramUserData");
            
            user = new User 
            {
                TelegramId = telegramData.Id ?? 0,
                Username = telegramData.Username
            };

            // Отправляем на бэкенд
            await Http.PostAsJsonAsync("http://localhost:5084/api/users/create", user);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка: {ex.Message}");
            // Заглушка для теста
            user = new User { TelegramId = 123, Username = "test_user" };
        }
    }

    private class TelegramUserData
    {
        public long? Id { get; set; }
        public string? Username { get; set; }
    }
}